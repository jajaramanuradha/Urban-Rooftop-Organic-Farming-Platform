*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4f8f3;color:#18311f;line-height:1.6}.navbar{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid #dfe8df;padding:14px 6%;display:flex;justify-content:space-between;align-items:center}.brand{color:#16733a;text-decoration:none;font-weight:bold;font-size:21px}.navbar nav{display:flex;gap:6px}.navbar nav a{color:#34523d;text-decoration:none;padding:8px 10px;border-radius:8px;font-size:14px}.navbar nav a.active,.navbar nav a:hover{background:#e5f5e8;color:#147536}.menu{display:none;background:none;border:0;font-size:25px}.container{width:min(1100px,92%);margin:35px auto}.hero{display:grid;grid-template-columns:2fr 1fr;gap:25px;background:#e7f6e9;border-radius:20px;padding:42px;margin-bottom:28px}.hero h1{font-size:42px;line-height:1.15}.hero p{color:#58705e}.badge{background:#d3efd9;color:#147536;padding:6px 12px;border-radius:20px;font-size:13px}.hero-card,.panel,.card,.info,.stats>div{background:#fff;border:1px solid #e0e9e1;border-radius:16px;padding:22px;box-shadow:0 5px 18px #18311f0d}.hero-card{text-align:center}.big-emoji{font-size:65px}.btn{display:inline-block;border:0;background:#16733a;color:#fff;padding:11px 18px;border-radius:9px;text-decoration:none;cursor:pointer;font-weight:bold;margin:5px 5px 5px 0}.secondary{background:#fff;color:#16733a;border:1px solid #a8cbb0}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:25px 0}.stats b{display:block;font-size:28px}.stats span{color:#718078}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{text-decoration:none;color:inherit}.card:hover{transform:translateY(-2px)}.card:first-letter{font-size:30px}.info{margin-top:25px;background:#eff8f0}.two{display:grid;grid-template-columns:1fr 1fr;gap:20px}.panel label{display:block;font-weight:bold;margin:14px 0}.panel input,.panel select,.search input{width:100%;padding:11px;border:1px solid #cbd8cd;border-radius:8px;margin-top:6px;font:inherit}.success{color:#16733a;font-weight:bold}.muted{color:#68786e}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px 18px}.crop{border:1px solid #dce7de;padding:13px;border-radius:10px;margin:10px 0;display:flex;justify-content:space-between;align-items:center}.delete{border:0;background:#ffe8e8;color:#a22;padding:7px;border-radius:6px}.recommend{background:#eff9f1;border-left:5px solid #16813f;padding:15px;margin:12px 0;border-radius:8px}.preview{display:none;max-width:100%;max-height:300px;border-radius:12px;margin:15px 0}.center{text-align:center}.search{display:flex;gap:10px}.search input{margin:0}.weather{margin-top:20px;background:#e6f5ff;border-radius:18px;padding:30px;display:grid;grid-template-columns:100px 1fr 1fr 1fr;align-items:center}.weather strong{font-size:50px}.bars p{display:grid;grid-template-columns:130px 1fr 50px;gap:10px;align-items:center}.bars i{height:13px;background:#e5ebe6;border-radius:20px;overflow:hidden}.bars i span{display:block;height:100%;background:#48a866}.number{font-size:40px;font-weight:bold;color:#16733a}.progress{height:18px;background:#e2eae3;border-radius:20px;overflow:hidden}.progress span{display:block;width:82%;height:100%;background:#3eaa60}footer{text-align:center;padding:30px;color:#718078;border-top:1px solid #dfe8df;margin-top:40px}@media(max-width:850px){.menu{display:block}.navbar nav{display:none;position:absolute;top:62px;left:0;right:0;background:#fff;padding:10px 6%;flex-direction:column}.navbar nav.open{display:flex}.hero,.two,.weather{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.grid{grid-template-columns:1fr 1fr}}@media(max-width:600px){.hero{padding:28px 20px}.hero h1{font-size:31px}.stats,.grid,.formgrid{grid-template-columns:1fr}.search{flex-direction:column}.bars p{grid-template-columns:90px 1fr 40px;font-size:13px}}